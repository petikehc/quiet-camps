{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "api:types": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
