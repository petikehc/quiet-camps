# Copy to api/.env (gitignored) and run: uv run uvicorn quiet_camps.api.app:create_app --factory --env-file .env
# POST /ask reads plain words with Claude on Amazon Bedrock (ADR 0005). Off unless set.
ASK_ENABLED=true
AWS_PROFILE=your-aws-profile
AWS_REGION=ap-southeast-2
# The defaults: Converse on bedrock-runtime, Claude Haiku 4.5 through the Australian profile.
# ASK_ENDPOINT=runtime
# ASK_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
