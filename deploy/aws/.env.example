# Copy to deploy/aws/.env (gitignored) for ship.sh and publish-db.sh.
AWS_PROFILE=your-aws-profile
# Neon: the project's direct connection string (not the -pooler one), as Neon shows it.
NEON_DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
# CloudFront sends this to the API, which turns away requests without it: openssl rand -hex 32
ORIGIN_SECRET=
# Optional: the site's own domain (ship.sh cert, then deploy). Empty: CloudFront's own domain.
DOMAIN=
